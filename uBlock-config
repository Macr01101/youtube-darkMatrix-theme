/* ----------------------------------------
   08. Smooth Transitions
   ---------------------------------------- */

youtube.com##yt-button-shape:style(transition: all .25s ease !important;)
youtube.com##yt-icon-button:style(transition: all .25s ease !important;)
youtube.com##ytd-button-renderer:style(transition: all .25s ease !important;)
youtube.com##yt-chip-cloud-chip-renderer:style(transition: all .25s ease !important;)
youtube.com##tp-yt-paper-icon-button:style(transition: all .25s ease !important;)


/* ----------------------------------------
   09. Hover Effects
   ---------------------------------------- */

youtube.com##yt-button-shape:hover:style(background-color: #003000 !important; border-radius: 8px !important;)
youtube.com##yt-icon-button:hover:style(background-color: #003000 !important; border-radius: 8px !important;)
youtube.com##ytd-button-renderer:hover:style(background-color: #003000 !important;)
youtube.com##yt-chip-cloud-chip-renderer:hover:style(background-color: #003000 !important; border-color: #00D100 !important;)
youtube.com##tp-yt-paper-icon-button:hover:style(background-color: #003000 !important;)
